{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Routine Launcher",
  "version": "0.1.3",
  "identifier": "com.zhongxuen.routinelauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Routine Launcher",
        "width": 1200,
        "height": 800,
        "minWidth": 680,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "publisher": "zhongxuen",
    "copyright": "Copyright © 2026 zhongxuen",
    "category": "Productivity",
    "shortDescription": "Routine launcher and productivity hub",
    "longDescription": "Launch a whole working setup — applications, folders, files and links — from one routine, and keep tasks, focus sessions and daily progress in the same place. All data stays on this machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Routine Launcher",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "473F5E2D-84DA-5A16-AEE6-CB8493535FE8",
        "language": ["en-US"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/zhongxuen/routine-launcher-productivity-system/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzMEFGQ0U4Q0FERTZGOUMKUldTY2I5N0s2UHdLazQvamZZTDZjTmlDUHdUaWdES3FCR04wVGw2V2FqTDQ5Mjd1SEdzWW9taW4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
